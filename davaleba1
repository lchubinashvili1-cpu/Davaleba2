<h2>საქაღალდის შექმნა</h2>

<form method="POST">
    საქაღალდის სახელი:
    <input type="text" name="folder" required>
    <button type="submit">შექმნა</button>
</form>

<?php
if (isset($_POST["folder"])) {
    $folder = $_POST["folder"];

    if (is_dir($folder)) {
        $message = "საქაღალდე უკვე არსებობს.";
    } else {
        if (mkdir($folder)) {
            $message = "საქაღალდე შეიქმნა წარმატებით.";
        } else {
            $message = "საქაღალდის შექმნა ვერ მოხერხდა.";
        }
    }
}

if (isset($_GET["show"]) && $_GET["show"] == 1) {
    if (isset($message)) {
        echo $message;
    } else {
        echo "ჯერ საქაღალდის სახელი შეიყვანე.";
    }
}
?>

