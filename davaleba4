<form method="GET">
    <input type="text" name="folder" placeholder="საქაღალდის სახელი" required>
    <button type="submit">ნახვა</button>
</form>

<?php
if (isset($_POST["folder"])) {
    $folder = basename($_POST["folder"]);

    if (!is_dir($folder)) {
        if (mkdir($folder)) {
            echo "მთავარი საქაღალდე შეიქმნა!";
        } else {
            echo "საქაღალდის შექმნა ვერ მოხერხდა!";
        }
    } else {
        echo "ასეთი საქაღალდე უკვე არსებობს!";
    }
}

if (isset($_GET["folder"])) {
    $folder = basename($_GET["folder"]);

    if (is_dir($folder)) {
        $files = scandir($folder);

        foreach ($files as $file) {
            if ($file != "." && $file != "..") {
                echo htmlspecialchars($file) . "<br>";
            }
        }
    } else {
        echo "ასეთი საქაღალდე არ არსებობს!";
    }
}
