<h2>საქაღალდის შიგთავსი</h2>

<form method="GET">
    <input type="text" name="folder" placeholder="საქაღალდის სახელი" required>
    <button type="submit">ნახვა</button>
</form>

<?php
if (isset($_POST["folder"]) && isset($_POST["file"])) {
    $folder = basename($_POST["folder"]);
    $file = basename($_POST["file"]);

    if (!is_dir($folder)) {
        mkdir($folder);
    }

    if (is_dir($folder)) {
        if (file_put_contents($folder . "/" . $file, "") !== false) {
            echo "ფაილი შეიქმნა!";
        } else {
            echo "ფაილის შექმნა ვერ მოხერხდა!";
        }
    }
}

if (isset($_GET["folder"])) {
    $folder = basename($_GET["folder"]);

    if (is_dir($folder)) {
        $files = scandir($folder);

        echo "<ul>";
        foreach ($files as $file) {
            if ($file != "." && $file != "..") {
                echo "<li>" . htmlspecialchars($file) . "</li>";
            }
        }
        echo "</ul>";
    } else {
        echo "საქაღალდე არ არსებობს!";
    }
}
