if (isset($_POST["main"]) && isset($_POST["sub"])) {
    $main = basename($_POST["main"]);
    $sub = basename($_POST["sub"]);

    if (!is_dir($main)) {
        mkdir($main);
    }

    if (is_dir($main)) {
        if (mkdir($main . "/" . $sub)) {
            echo "საქაღალდეები შეიქმნა!";
        } else {
            echo "ქვესაქაღალდე ვერ შეიქმნა ან უკვე არსებობს!";
        }
    }
}

if (isset($_GET["folder"])) {
    $folder = basename($_GET["folder"]);

    if (is_dir($folder)) {
        $files = scandir($folder);

        echo "<ol>";
        foreach ($files as $file) {
            if ($file != "." && $file != "..") {
                echo "<li>" . htmlspecialchars($file) . "</li>";
            }
        }
        echo "</ol>";
    } else {
        echo "მთავარი საქაღალდე არ არსებობს!";
    }
}
